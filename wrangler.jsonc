{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docs-wpm-so",
  "compatibility_date": "2026-01-23",
  "assets": {
    "directory": "./out",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": false,
    "traces": {
      "enabled": false
    }
  },
  "routes": [
    {
      "pattern": "wpm.so/docs",
      "zone_name": "wpm.so"
    },
    {
      "pattern": "wpm.so/docs/*",
      "zone_name": "wpm.so"
    }
  ]
}
